

# Параметризуем версию Node.js с значением по умолчанию 22
ARG NODE_VERSION=22

# Используем аргумент в инструкции FROM
FROM node:${NODE_VERSION}-alpine

# Опционально: можно сделать аргумент доступным на следующих этапах сборки
ARG NODE_VERSION

# Устанавливаем рабочую директорию
WORKDIR /app

# Копируем файлы зависимостей
COPY package*.json ./

# Устанавливаем зависимости
RUN npm install

# Копируем остальной код приложения
COPY . .

# Открываем порт (если нужно)
EXPOSE 3000

# Запускаем приложение
CMD ["npm", "start"]